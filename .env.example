# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manzil_bharat
DB_USER=postgres
DB_PASSWORD=

# Hosted databases (Render + Neon) supply ONE URL that already carries the
# host, user, password and sslmode. When it is set it WINS over the five
# variables above - paste Neon's connection string here. It contains a
# password: never commit it and never put it in a .js/.html file.
DATABASE_URL=
# Force the connection's sslmode when a provider needs it (e.g. disable for a
# local server without SSL). Empty = whatever the URL or the libpq default says.
DB_SSLMODE=
# Seconds to wait before giving up (Neon scales compute to zero after 5 minutes
# of idle and wakes on connect). Keep this below the host's health-check timeout.
DB_CONNECT_TIMEOUT=5

# Flask
PORT=5000

# Public origin(s) of the live site, comma separated - used for CORS and for
# building password-reset links, e.g. https://manzil-bharat.onrender.com
APP_ORIGIN=

# Google Sign-In
GOOGLE_CLIENT_ID=

# AI travel guide (Google AI Studio -> https://aistudio.google.com/apikey)
# Used ONLY by the server (/api/ai-guide). Never put this key in a .js or
# .html file - anything sent to the browser is public.
GEMINI_API_KEY=
# Model used by /api/ai-guide
GEMINI_MODEL=gemini-3.6-flash

# Admin panel. ADMIN_PASSWORD must be at least 12 characters;
# the server refuses to start otherwise.
ADMIN_EMAIL=admin@manzilbharat.in
ADMIN_PASSWORD=

# Signs admin and user JWTs. Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this logs everyone out, so never rotate it casually.
JWT_SECRET=

# Password-reset email (optional)
# Provider: smtp | resend | brevo
#   smtp    direct SMTP on 587 - fine locally, but Render's FREE plan blocks
#             outbound 25/465/587, so it cannot work on that host
#   resend  HTTPS API on 443 -> https://api.resend.com
#   brevo   HTTPS API on 443 -> https://api.brevo.com
# Empty = inferred from whichever key below is present (resend > brevo > smtp).
EMAIL_PROVIDER=
# HTTPS providers (port 443 - allowed everywhere). Free tiers; resend needs a
# verified sender domain, brevo accepts a verified address you already own.
RESEND_API_KEY=
BREVO_API_KEY=
# Sender both APIs accept, e.g. resets@yourdomain.in. Required by resend/brevo.
EMAIL_FROM=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
