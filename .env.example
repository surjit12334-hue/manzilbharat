# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=manzil_bharat
DB_USER=postgres
DB_PASSWORD=

# Flask
PORT=5000

# Google Sign-In
GOOGLE_CLIENT_ID=

# Admin panel. ADMIN_PASSWORD must be at least 12 characters;
# the server refuses to start otherwise.
ADMIN_EMAIL=admin@manzilbharat.in
ADMIN_PASSWORD=

# Signs admin and user JWTs. Must be at least 32 characters.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Changing this logs everyone out, so never rotate it casually.
JWT_SECRET=

# Password-reset email (optional)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
